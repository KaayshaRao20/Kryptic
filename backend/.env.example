# KRYPTIC Backend Environment Configuration

PROJECT_NAME="KRYPTIC Risk & Digital Twin Engine"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
# Generate a strong 256-bit secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY="kryptic-insecure-dev-secret-key-change-in-production-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@hostname:port/database_name
# For local development without PostgreSQL, fallback SQLite is supported: sqlite:///./kryptic.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kryptic"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration
# Format: redis://localhost:6379/0
REDIS_URL="redis://localhost:6379/0"
REDIS_KEY_PREFIX="kryptic:"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Simulation Settings
DEFAULT_SIMULATION_TPS=5
MAX_SIMULATION_EVENTS=1000
